<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F6F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/refill_medicine_title"
            android:textColor="#202124"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRefillMedicineName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/medicine_name_label"
            android:textColor="#252642"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCurrentStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/current_stock_label"
            android:textColor="#20243A"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/quantity_added"
            android:textColor="#202124"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etRefillQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/refill_quantity_hint"
            android:inputType="numberDecimal"
            android:minHeight="52dp"
            android:textColor="#20243A"
            android:padding="12dp"
            android:singleLine="true"
            tools:ignore="Autofill,TextContrastCheck,VisualLintTextFieldSize" />

        <Button
            android:id="@+id/btnConfirmRefill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="52dp"
            android:text="@string/add_to_current_stock"
            android:textAllCaps="false"
            tools:ignore="VisualLintButtonSize" />

    </LinearLayout>
</ScrollView>
