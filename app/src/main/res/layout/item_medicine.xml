<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivMedicineImage"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:contentDescription="@string/medicine_photo"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"
                tools:ignore="ImageContrastCheck" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMedicineName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/medicine_name"
                    android:textColor="#202124"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:ignore="VisualLintSystemUi" />

                <TextView
                    android:id="@+id/tvDosage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/dosage"
                    android:textColor="#666666"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvReminderTimes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="@string/reminder_08_00"
                    android:textColor="#4455A4"
                    android:textSize="13sp" />

            </LinearLayout>
        </LinearLayout>
        <!-- Medicine stock status -->
        <LinearLayout
            android:id="@+id/layoutStockStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#F6F7FB"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvStockQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stock remaining: Stock not set"
                android:textColor="#252642"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStockDaysRemaining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Estimated supply: —"
                android:textColor="#626579"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvStockWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#B45309"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Medicine notes -->
        <TextView
            android:id="@+id/tvMedicineNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#F6F7FB"
            android:padding="10dp"
            android:textColor="#454B60"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Edit and delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit"
                android:textAllCaps="false"
                tools:ignore="ButtonStyle" />
            <Button
                android:id="@+id/btnRefill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Refill"
                android:textAllCaps="false"
                tools:ignore="ButtonStyle" />
            <Button
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/delete"
                android:textAllCaps="false"
                tools:ignore="ButtonStyle" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#E8E8E8" />

        <LinearLayout
            android:id="@+id/layoutDoseActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</androidx.cardview.widget.CardView>